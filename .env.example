# Gemini (optional — templates FR work without it)
GEMINI_API_KEY=

# Stripe — paste LIVE keys for real money (Dashboard → Developers → API keys)
# Use sk_test_ / pk_test_ first to verify the flow, then switch to sk_live_ / pk_live_
STRIPE_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# Create product "RelanceCash Early Bird Lifetime" at 19.00 EUR one-time, then paste Price ID
STRIPE_PRICE_ID=price_REPLACE

NEXT_PUBLIC_APP_URL=http://localhost:3000
FREE_GENERATIONS=2
PRICE_EUR=19
